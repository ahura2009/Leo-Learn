# آدرس سرویس احراز هویت (سمت مرورگر، در زمان build درج می‌شود)
# در توسعه خالی بماند؛ Next درخواست‌های /v1 را به سرور محلی proxy می‌کند.
# در استقرار، آدرس کامل و هم‌سایت باشد، مثل https://app.leolearn.ir/v1
NEXT_PUBLIC_AUTH_API_URL=

# آدرس سرور auth برای proxy توسعه (اختیاری)
AUTH_DEV_API_URL=http://127.0.0.1:8787

# ---------- سرور auth (server/auth) ----------
NODE_ENV=development
AUTH_HOST=127.0.0.1
AUTH_PORT=8787

# در production اجباری و حداقل ۳۲ کاراکتر
AUTH_SESSION_SECRET=

# مسیر SQLite برای اجرای محلی/نمونه
AUTH_DB_PATH=./server/auth/data/auth.sqlite

# مبدأهای مجاز مرورگر (با کاما جدا شوند)
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# ارسال پیامک: mediana | kavenegar | webhook | console (console فقط توسعه)
AUTH_SMS_PROVIDER=console

# مدیانا — API Key از پنل و کد الگوی OTP (patternCode)
MEDIANA_API_KEY=
MEDIANA_PATTERN_CODE=

KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=

# OTP
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5

# نشست
AUTH_SESSION_DAYS=30
AUTH_COOKIE_NAME=leo_auth
AUTH_COOKIE_SECURE=true
